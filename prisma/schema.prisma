model Campaign {
  id     String   @id @default(uuid())
  name   String
  date   DateTime
  time   String
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Add other fields as necessary

  @@index([userId])
}

model EmailTemplate {
  id        String                @id @default(uuid())
  subject   String                @db.Text
  content   String                @db.Text
  userId    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  nodes     EmailAutomationNode[]

  @@index([userId])
}

model EmailAutomation {
  id        String                @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  nodes     EmailAutomationNode[]
  edges     EmailAutomationEdge[]

  @@index([userId])
}

model EmailAutomationNode {
  id           String          @id @default(uuid())
  type         String // 'email' | 'delay' | 'condition'
  position     Json // { x: number, y: number }
  data         Json // Store node-specific data
  automationId String
  templateId   String? // Only for email nodes
  automation   EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  template     EmailTemplate?  @relation(fields: [templateId], references: [id])

  @@index([automationId])
  @@index([templateId])
}

model EmailAutomationEdge {
  id           String          @id @default(uuid())
  source       String // Node ID
  target       String // Node ID
  automationId String
  automation   EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model MusicProfile {
  id       String @id @default(uuid())
  platform String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Add other fields as necessary

  @@index([userId])
}

model VectorEmbedding {
  id        String   @id @default(uuid())
  content   String?  @db.Text
  embedding Json?    @db.Json
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChapterEmbedding {
  id        String        @id @default(uuid())
  embedding Json?         @db.Json
  chapterId String        @unique
  chapter   CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([chapterId])
}

model Playlist {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String?        @unique @default(uuid())
  description          String?        @db.Text
  genre                String?
  mood                 String?
  isPublic             Boolean        @default(false)
  userId               String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  contactEmail         String?        @db.Text
  submissionEnabled    Boolean        @default(false)
  submissionGuidelines String?        @db.Text
  platform             MusicPlatform?
  imagePath            String?        @db.Text
  url                  String?        @db.Text
  songs                Song[]
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Resource {
  id                     String         @id @default(uuid())
  title                  String
  slug                   String         @unique
  description            String         @db.Text
  fileName               String
  fileUrl                String         @db.Text
  imageUrl               String?        @db.Text
  requiresLeadGen        Boolean        @default(false)
  followGateRequirements Json?          @db.Json
  downloads              Int            @default(0)
  type                   String?
  userId                 String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  leads                  ResourceLead[]

  @@index([userId])
}

model ResourceLead {
  id         String   @id @default(uuid())
  name       String
  email      String
  resourceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([email])
}

model MigrationCode {
  id                   String    @id @default(cuid())
  code                 String    @unique
  email                String
  courseId             String
  originalPurchaseId   String?
  originalPurchaseDate DateTime?
  used                 Boolean   @default(false)
  createdAt            DateTime  @default(now())
  expiresAt            DateTime?

  course Course @relation(fields: [courseId], references: [id])

  @@index([code])
  @@index([email])
  @@index([courseId])
}
